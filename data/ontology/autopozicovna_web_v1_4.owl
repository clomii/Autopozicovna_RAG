<?xml version='1.0' encoding='UTF-8'?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:base="http://www.semanticweb.org/autopozicovna/ontologies/2026/8/autopozicovna" ontologyIRI="http://www.semanticweb.org/autopozicovna/ontologies/2026/8/autopozicovna" versionIRI="http://www.semanticweb.org/autopozicovna/ontologies/2026/8/autopozicovna/v1.4">
